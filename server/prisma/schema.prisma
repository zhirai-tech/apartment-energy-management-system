generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  boss
  user
}

enum RoomStatus {
  normal
  warning_80
  warning_90
  warning_95
  cutoff
  offline
}

enum AlarmType {
  limit_80
  limit_90
  limit_95
  limit_reached
  device_offline
  control_failed
  sync_failed
}

enum AlarmLevel {
  info
  warning
  danger
  critical
}

enum OperationType {
  login
  logout
  update_limit
  cutoff_power
  restore_power
  update_alarm
  update_settings
  sync_devices
  control_device
}

enum DeviceStatus {
  online
  offline
  unknown
}

enum SiteAdapterType {
  xiaomi_cloud
  tuya_cloud
  local_bridge
  custom_api
}

enum NodeType {
  master
  edge
}

enum NodeStatus {
  online
  offline
  unknown
  syncing
}

model Role {
  id        String   @id @default(cuid())
  name      UserRole @unique
  users     User[]
  createdAt DateTime @default(now())
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  passwordHash String
  name         String
  mustChangePassword Boolean @default(false)
  passwordUpdatedAt DateTime?
  roleId       String
  role         Role          @relation(fields: [roleId], references: [id])
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  operationLogs OperationLog[]
}

model Site {
  id                   String          @id @default(cuid())
  code                 String          @unique
  name                 String
  description          String?
  adapterType          SiteAdapterType @default(xiaomi_cloud)
  isPrimary            Boolean         @default(false)
  storageRetentionDays Int             @default(365)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  rooms   Room[]
  devices Device[]
  nodes   EdgeNode[]
}

model EdgeNode {
  id                    String     @id @default(cuid())
  siteId                String
  site                  Site       @relation(fields: [siteId], references: [id])
  code                  String
  name                  String
  nodeType              NodeType   @default(edge)
  status                NodeStatus @default(unknown)
  localApiBaseUrl       String?
  storageRetentionDays  Int        @default(90)
  isLocalControlEnabled Boolean    @default(true)
  lastHeartbeatAt       DateTime?
  lastSyncAt            DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@unique([siteId, code])
  @@index([siteId, status])
}

model Room {
  id         String       @id @default(cuid())
  siteId     String
  site       Site         @relation(fields: [siteId], references: [id])
  roomNumber String
  name       String
  floor      Int          @default(1)
  status     RoomStatus   @default(normal)
  cutoff     Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  devices    Device[]
  energyLimit EnergyLimit?
  dailyEnergy DailyEnergy[]
  hourlyEnergy HourlyEnergy[]
  monthlyEnergy MonthlyEnergy[]
  alarmLogs  AlarmLog[]
  operationLogs OperationLog[]

  @@unique([siteId, roomNumber])
  @@index([siteId])
}

model Device {
  id         String       @id @default(cuid())
  did        String       @unique
  siteId     String
  site       Site         @relation(fields: [siteId], references: [id])
  name       String
  model      String
  roomId     String?
  room       Room?        @relation(fields: [roomId], references: [id])
  status     DeviceStatus @default(unknown)
  power      Boolean?
  powerW     Float?
  currentA   Float?
  voltageV   Float?
  totalKwh   Float?
  lastSyncAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  dailyNetworkTraffic DailyNetworkTraffic[]

  @@index([siteId])
}

model EnergyLimit {
  id         String   @id @default(cuid())
  roomId     String   @unique
  room       Room     @relation(fields: [roomId], references: [id])
  dailyLimit Float    @default(10)
  enabled    Boolean  @default(false)
  monthlyCostLimit Float @default(0)
  costEnabled Boolean @default(false)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}

model DailyEnergy {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id])
  date      DateTime
  usageKwh  Float    @default(0)
  cost      Float    @default(0)
  peakW     Float    @default(0)
  createdAt DateTime @default(now())

  @@unique([roomId, date])
  @@index([date])
}

model DailyNetworkTraffic {
  id         String   @id @default(cuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id])
  date       DateTime
  rxBytes    Float    @default(0)
  txBytes    Float    @default(0)
  totalBytes Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([deviceId, date])
  @@index([date])
}

model HourlyEnergy {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id])
  date      DateTime
  hour      Int
  usageKwh  Float    @default(0)
  peakW     Float    @default(0)
  createdAt DateTime @default(now())

  @@unique([roomId, date, hour])
  @@index([date])
}

model MonthlyEnergy {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id])
  year      Int
  month     Int
  usageKwh  Float    @default(0)
  cost      Float    @default(0)
  createdAt DateTime @default(now())

  @@unique([roomId, year, month])
}

model AlarmLog {
  id         String     @id @default(cuid())
  type       AlarmType
  level      AlarmLevel
  roomId     String?
  room       Room?      @relation(fields: [roomId], references: [id])
  message    String
  resolved   Boolean    @default(false)
  resolvedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([createdAt])
}

model OperationLog {
  id         String        @id @default(cuid())
  type       OperationType
  userId     String?
  user       User?         @relation(fields: [userId], references: [id])
  roomId     String?
  room       Room?         @relation(fields: [roomId], references: [id])
  details    String
  success    Boolean       @default(true)
  createdAt  DateTime      @default(now())

  @@index([createdAt])
}

model SystemSettings {
  id             String  @id @default(cuid())
  key            String  @unique
  value          String
  description    String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}
