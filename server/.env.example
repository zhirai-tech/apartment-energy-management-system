DATABASE_URL="postgresql://zaem:zaem_password@localhost:5432/zaem_db?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="zaem_jwt_secret_change_in_production_please_use_strong_random_string"
PORT=3001
CORS_ORIGIN="http://localhost:3000"
NODE_ENV=development
XIAOMI_USERNAME=""
